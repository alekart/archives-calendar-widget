{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "create-block/arcw",
  "version": "2.0.0",
  "title": "ARCW",
  "category": "widgets",
  "icon": "smiley",
  "description": "Example block scaffolded with Create Block tool.",
  "example": {},
  "attributes": {
    "mode": {
      "type": "string",
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "month",
            "year"
          ]
        }
      ],
      "default": "month"
    },
    "firstMonth": {
      "type": "string",
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "latest",
            "current",
            "next",
            "previous"
          ]
        }
      ]
    },
    "categories": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "default": {}
    },
    "postTypes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "theme": {
      "type": "string"
    }
  },
  "supports": {
    "html": false
  },
  "textdomain": "arcw",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js"
}
