{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "create-block/arcw",
  "version": "2.0.0",
  "title": "ARCW",
  "category": "widgets",
  "icon": "smiley",
  "description": "Example block scaffolded with Create Block tool.",
  "example": {},
  "attributes": {
    "mode": {
      "type": "string",
      "enum": ["year", "month"]
    },
    "firstMonth": {
      "type": "string",
      "enum": ["latest", "current", "next", "previous"]
    },
    "categories": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "postTypes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "theme": {
      "type": "string"
    }
  },
  "supports": {
    "html": false
  },
  "textdomain": "arcw",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "viewScript": "file:./view.js"
}
